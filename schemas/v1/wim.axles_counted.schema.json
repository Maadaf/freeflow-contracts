{
  "$defs": {
    "WimObservation": {
      "additionalProperties": false,
      "description": "Piezo/WIM: contagem fiável de eixos. Sem peso/massa — não é pesagem.",
      "properties": {
        "axle_count": {
          "maximum": 16,
          "minimum": 2,
          "title": "Axle Count",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "detected_position_m": {
          "default": 0,
          "title": "Detected Position M",
          "type": "number"
        },
        "event_type": {
          "const": "wim.axles_counted",
          "default": "wim.axles_counted",
          "title": "Event Type",
          "type": "string"
        },
        "lane": {
          "title": "Lane",
          "type": "integer"
        },
        "lateral_offset_m": {
          "default": 0,
          "title": "Lateral Offset M",
          "type": "number"
        },
        "passage_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "sensing": {
          "const": "piezo",
          "default": "piezo",
          "description": "Método físico: bandas piezoelétricas (contagem, não pesagem).",
          "title": "Sensing",
          "type": "string"
        },
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "sensor_timestamp_offset_ms": {
          "default": 0,
          "title": "Sensor Timestamp Offset Ms",
          "type": "number"
        },
        "sensor_type": {
          "const": "wim",
          "default": "wim",
          "title": "Sensor Type",
          "type": "string"
        },
        "speed_kmh": {
          "exclusiveMinimum": 0,
          "title": "Speed Kmh",
          "type": "number"
        },
        "vehicle_class": {
          "$ref": "#/$defs/VehicleClass"
        }
      },
      "required": [
        "passage_id",
        "sensor_id",
        "lane",
        "speed_kmh",
        "vehicle_class",
        "confidence",
        "axle_count"
      ],
      "title": "WimObservation",
      "type": "object"
    },
    "VehicleClass": {
      "enum": [
        "light",
        "heavy",
        "motorcycle"
      ],
      "title": "VehicleClass",
      "type": "string"
    }
  },
  "$id": "https://schemas.freeflow.local/events/v1/wim.axles_counted.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/WimObservation"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "gantry_id": {
      "title": "Gantry Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "source",
    "gantry_id",
    "correlation_id",
    "data"
  ],
  "title": "WimEventEnvelope",
  "type": "object"
}

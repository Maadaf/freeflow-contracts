{
  "$defs": {
    "AntennaObservation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "cross_read": {
          "default": false,
          "title": "Cross Read",
          "type": "boolean"
        },
        "detected_position_m": {
          "default": 0,
          "title": "Detected Position M",
          "type": "number"
        },
        "event_type": {
          "const": "antenna.tag_read",
          "default": "antenna.tag_read",
          "title": "Event Type",
          "type": "string"
        },
        "lane": {
          "title": "Lane",
          "type": "integer"
        },
        "lateral_offset_m": {
          "default": 0,
          "title": "Lateral Offset M",
          "type": "number"
        },
        "passage_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "protocol": {
          "const": "ISO-18000-6C",
          "default": "ISO-18000-6C",
          "title": "Protocol",
          "type": "string"
        },
        "read_lane": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Lane"
        },
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "sensor_timestamp_offset_ms": {
          "default": 0,
          "title": "Sensor Timestamp Offset Ms",
          "type": "number"
        },
        "sensor_type": {
          "const": "antenna",
          "default": "antenna",
          "title": "Sensor Type",
          "type": "string"
        },
        "speed_kmh": {
          "exclusiveMinimum": 0,
          "title": "Speed Kmh",
          "type": "number"
        },
        "tag_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag Id"
        },
        "vehicle_class": {
          "$ref": "#/$defs/VehicleClass"
        }
      },
      "required": [
        "passage_id",
        "sensor_id",
        "lane",
        "speed_kmh",
        "vehicle_class",
        "confidence"
      ],
      "title": "AntennaObservation",
      "type": "object"
    },
    "CameraObservation": {
      "additionalProperties": false,
      "properties": {
        "blur": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Blur",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "detected_position_m": {
          "default": 0,
          "title": "Detected Position M",
          "type": "number"
        },
        "event_type": {
          "const": "camera.plate_read",
          "default": "camera.plate_read",
          "title": "Event Type",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceReference"
        },
        "lane": {
          "title": "Lane",
          "type": "integer"
        },
        "lateral_offset_m": {
          "default": 0,
          "title": "Lateral Offset M",
          "type": "number"
        },
        "lighting": {
          "$ref": "#/$defs/Lighting",
          "default": "day"
        },
        "passage_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "plate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plate"
        },
        "plate_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Plate Confidence",
          "type": "number"
        },
        "plate_country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plate Country"
        },
        "plate_occluded": {
          "default": false,
          "title": "Plate Occluded",
          "type": "boolean"
        },
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "sensor_timestamp_offset_ms": {
          "default": 0,
          "title": "Sensor Timestamp Offset Ms",
          "type": "number"
        },
        "sensor_type": {
          "const": "camera",
          "default": "camera",
          "title": "Sensor Type",
          "type": "string"
        },
        "speed_kmh": {
          "exclusiveMinimum": 0,
          "title": "Speed Kmh",
          "type": "number"
        },
        "vehicle_class": {
          "$ref": "#/$defs/VehicleClass"
        },
        "weather": {
          "$ref": "#/$defs/Weather",
          "default": "clear"
        }
      },
      "required": [
        "passage_id",
        "sensor_id",
        "lane",
        "speed_kmh",
        "vehicle_class",
        "confidence",
        "plate_confidence",
        "evidence"
      ],
      "title": "CameraObservation",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "height_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Px"
        },
        "media_type": {
          "const": "image/jpeg",
          "default": "image/jpeg",
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^(sim|s3|file)://",
          "title": "Uri",
          "type": "string"
        },
        "width_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Px"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "LidarObservation": {
      "additionalProperties": false,
      "properties": {
        "axle_count": {
          "maximum": 16,
          "minimum": 2,
          "title": "Axle Count",
          "type": "integer"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "detected_position_m": {
          "default": 0,
          "title": "Detected Position M",
          "type": "number"
        },
        "dimensions": {
          "$ref": "#/$defs/VehicleDimensions"
        },
        "event_type": {
          "const": "lidar.vehicle_profiled",
          "default": "lidar.vehicle_profiled",
          "title": "Event Type",
          "type": "string"
        },
        "has_trailer": {
          "default": false,
          "title": "Has Trailer",
          "type": "boolean"
        },
        "lane": {
          "title": "Lane",
          "type": "integer"
        },
        "lateral_offset_m": {
          "default": 0,
          "title": "Lateral Offset M",
          "type": "number"
        },
        "passage_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "point_count": {
          "default": 1200,
          "exclusiveMinimum": 0,
          "title": "Point Count",
          "type": "integer"
        },
        "profile_quality": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Profile Quality",
          "type": "number"
        },
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "sensor_timestamp_offset_ms": {
          "default": 0,
          "title": "Sensor Timestamp Offset Ms",
          "type": "number"
        },
        "sensor_type": {
          "const": "lidar",
          "default": "lidar",
          "title": "Sensor Type",
          "type": "string"
        },
        "speed_kmh": {
          "exclusiveMinimum": 0,
          "title": "Speed Kmh",
          "type": "number"
        },
        "vehicle_class": {
          "$ref": "#/$defs/VehicleClass"
        }
      },
      "required": [
        "passage_id",
        "sensor_id",
        "lane",
        "speed_kmh",
        "vehicle_class",
        "confidence",
        "dimensions",
        "axle_count"
      ],
      "title": "LidarObservation",
      "type": "object"
    },
    "Lighting": {
      "enum": [
        "day",
        "dusk",
        "night"
      ],
      "title": "Lighting",
      "type": "string"
    },
    "RadarObservation": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "detected_position_m": {
          "default": 0,
          "title": "Detected Position M",
          "type": "number"
        },
        "event_type": {
          "const": "radar.vehicle_detected",
          "default": "radar.vehicle_detected",
          "title": "Event Type",
          "type": "string"
        },
        "heading_degrees": {
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Heading Degrees",
          "type": "number"
        },
        "is_ghost": {
          "default": false,
          "title": "Is Ghost",
          "type": "boolean"
        },
        "lane": {
          "title": "Lane",
          "type": "integer"
        },
        "lateral_offset_m": {
          "default": 0,
          "title": "Lateral Offset M",
          "type": "number"
        },
        "passage_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "sensor_id": {
          "title": "Sensor Id",
          "type": "string"
        },
        "sensor_timestamp_offset_ms": {
          "default": 0,
          "title": "Sensor Timestamp Offset Ms",
          "type": "number"
        },
        "sensor_type": {
          "const": "radar",
          "default": "radar",
          "title": "Sensor Type",
          "type": "string"
        },
        "speed_kmh": {
          "exclusiveMinimum": 0,
          "title": "Speed Kmh",
          "type": "number"
        },
        "vehicle_class": {
          "$ref": "#/$defs/VehicleClass"
        }
      },
      "required": [
        "passage_id",
        "sensor_id",
        "lane",
        "speed_kmh",
        "vehicle_class",
        "confidence",
        "heading_degrees"
      ],
      "title": "RadarObservation",
      "type": "object"
    },
    "VehicleClass": {
      "enum": [
        "light",
        "heavy",
        "motorcycle"
      ],
      "title": "VehicleClass",
      "type": "string"
    },
    "VehicleDimensions": {
      "additionalProperties": false,
      "properties": {
        "height_m": {
          "exclusiveMinimum": 0,
          "title": "Height M",
          "type": "number"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "title": "Width M",
          "type": "number"
        }
      },
      "required": [
        "length_m",
        "width_m",
        "height_m"
      ],
      "title": "VehicleDimensions",
      "type": "object"
    },
    "Weather": {
      "enum": [
        "clear",
        "rain",
        "fog"
      ],
      "title": "Weather",
      "type": "string"
    }
  },
  "$id": "https://schemas.freeflow.local/events/v1/event-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "data": {
      "discriminator": {
        "mapping": {
          "antenna.tag_read": "#/$defs/AntennaObservation",
          "camera.plate_read": "#/$defs/CameraObservation",
          "lidar.vehicle_profiled": "#/$defs/LidarObservation",
          "radar.vehicle_detected": "#/$defs/RadarObservation"
        },
        "propertyName": "event_type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RadarObservation"
        },
        {
          "$ref": "#/$defs/LidarObservation"
        },
        {
          "$ref": "#/$defs/CameraObservation"
        },
        {
          "$ref": "#/$defs/AntennaObservation"
        }
      ],
      "title": "Data"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "gantry_id": {
      "title": "Gantry Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "source",
    "gantry_id",
    "correlation_id",
    "data"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
